# ========================================================
# AI Pothole Detection & Road Intelligence System - Environment Variables
# ========================================================

# General Configuration
PROJECT_NAME="AI Pothole Detection & Road Intelligence System"
API_V1_PREFIX="/api/v1"

# Database Connection (Default SQLite for local setup; or PostgreSQL with PostGIS for production)
DATABASE_URL="sqlite:///./pothole_intelligence.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/road_hazards_db"

# API Authentication Key
ROAD_AI_API_KEY="road-hazard-api-key-2026"

# Computer Vision Inference Configuration
CONFIDENCE_THRESHOLD=0.35
MODEL_WEIGHTS_PATH="backend/app/weights/pothole_yolov8n.pt"

# Spatial Clustering & Aggregation Thresholds
CLUSTER_RADIUS_METERS=20.0
VERIFICATION_MIN_OBSERVATIONS=3
VERIFICATION_MIN_DEVICES=2
HAZARD_EXPIRY_DAYS=30

# ADAS Threat Cone Parameters
ADAS_WARNING_DISTANCE_METERS=150.0
ADAS_WARNING_CONE_DEGREES=45.0

# File Storage
UPLOAD_DIR="backend/uploads"
